rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function own(uid) { return googleUser() && request.auth.uid == uid; }
    function historyValid(slug) {
      let d = request.resource.data;
      return d.keys().hasOnly(['movieSlug','movieTitle','posterUrl','bannerUrl','episodeSlug','episodeName','serverName','positionMs','durationMs','timestamp','deleted','updatedAt'])
        && d.keys().hasAll(['movieSlug','movieTitle','posterUrl','bannerUrl','episodeSlug','episodeName','serverName','positionMs','durationMs','timestamp','deleted','updatedAt'])
        && slug.matches('^[a-zA-Z0-9_-]{1,180}$') && d.movieSlug == slug
        && d.movieTitle is string && d.movieTitle.size() <= 300
        && d.posterUrl is string && d.posterUrl.size() <= 2048
        && (d.posterUrl == '' || d.posterUrl.matches('^https://.*'))
        && d.bannerUrl is string && d.bannerUrl.size() <= 2048
        && (d.bannerUrl == '' || d.bannerUrl.matches('^https://.*'))
        && d.episodeSlug is string && d.episodeSlug.size() <= 180
        && d.episodeName is string && d.episodeName.size() <= 200
        && d.serverName is string && d.serverName.size() <= 200
        && d.positionMs is int && d.positionMs >= 0 && d.positionMs <= 31536000000
        && d.durationMs is int && d.durationMs >= 0 && d.durationMs <= 31536000000
        && d.timestamp is int && d.timestamp > 0 && d.timestamp <= request.time.toMillis() + 600000
        && d.deleted is bool && d.updatedAt == request.time;
    }
    match /users/{uid}/history/{slug} {
      allow read: if own(uid);
      allow create: if own(uid) && historyValid(slug);
      allow update: if own(uid) && historyValid(slug) && request.resource.data.timestamp >= resource.data.timestamp;
      allow delete: if false; // Tombstones prevent stale offline clients restoring deleted history.
    }
    match /users/{uid}/meta/history {
      allow read: if own(uid);
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly(['clearedAt'])
        && request.resource.data.clearedAt is int && request.resource.data.clearedAt >= 0
        && request.resource.data.clearedAt <= request.time.toMillis() + 600000
        && (!exists(/databases/$(database)/documents/users/$(uid)/meta/history) || request.resource.data.clearedAt >= resource.data.clearedAt);
    }
    match /pairings/{id} {
      function owner() { return request.auth != null && request.auth.uid == resource.data.ownerUid; }
      allow list: if false;
      allow get: if owner() || (googleUser() && request.time < resource.data.expiresAt);
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && id.matches('^[a-zA-Z0-9_-]{22}$')
        && request.resource.data.keys().hasOnly(['ownerUid','createdAt','expiresAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(10, 'm');
      allow update: if googleUser() && request.time < resource.data.expiresAt
        && !resource.data.keys().hasAny(['payload'])
        && request.resource.data.keys().hasOnly(['ownerUid','createdAt','expiresAt','senderUid','payload','iv','claimedAt'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.claimedAt == request.time
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 16384
        && request.resource.data.iv is string && request.resource.data.iv.size() == 16;
      allow delete: if owner() || (googleUser() && resource.data.senderUid == request.auth.uid);
    }
  }
}
